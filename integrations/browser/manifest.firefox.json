{
  "manifest_version": 3,
  "name": "Lyn Context Provider",
  "version": "0.1.0",
  "description": "Privacy-bounded local context integration for Lyn",
  "browser_specific_settings": {
    "gecko": {
      "id": "lyn-context-provider@mibienpanjoe.com"
    }
  },
  "background": {
    "scripts": ["sanitize.js", "background.js"]
  },
  "permissions": ["tabs", "windows", "nativeMessaging"],
  "commands": {
    "lyn.capture": {
      "description": "Lyn: Capture from this tab",
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "MacCtrl+Shift+L"
      }
    }
  }
}
