{
  "name": "lyn-context-provider",
  "displayName": "Lyn Context Provider",
  "description": "Supplies invocation-bound VS Code workspace identity to the local Lyn desktop app.",
  "publisher": "mibienpanjoe",
  "version": "0.1.4",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "lyn",
    "context",
    "workspace"
  ],
  "main": "./extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "lyn.capture"
      ]
    },
    "commands": [
      {
        "command": "lyn.capture",
        "title": "Lyn: Capture from this window"
      }
    ],
    "keybindings": [
      {
        "command": "lyn.capture",
        "key": "alt+l",
        "mac": "alt+l",
        "when": "terminalFocus",
        "args": {
          "surface": "terminal"
        }
      },
      {
        "command": "lyn.capture",
        "key": "alt+l",
        "mac": "alt+l",
        "when": "!terminalFocus && (editorTextFocus || filesExplorerFocus || !inQuickOpen)",
        "args": {
          "surface": "editor"
        }
      }
    ]
  },
  "files": [
    "extension.cjs",
    "observation.cjs",
    "README.md"
  ],
  "private": true
}
