{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyn",
  "version": "0.1.0",
  "identifier": "com.mibienpanjoe.lyn",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lyn",
        "width": 1040,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "capture",
        "title": "Lyn",
        "url": "index.html?surface=capture",
        "width": 640,
        "height": 210,
        "minWidth": 520,
        "minHeight": 200,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
